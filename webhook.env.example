# Copy to ~/.config/infinitary-grokbot-bridge/webhook.env and chmod 600.
# Plain NAME=value lines; the file is read as data, never sourced by a shell.
# Both values below are public placeholders. Replace them with your Grok Bot
# "Infinitary updates" routine's Webhook URL and Webhook key (the bare key).
# Add no other line: the bridge sends the Authorization header itself.
GROKBOT_WEBHOOK_URL=https://grokbot.example.com/webhook
GROKBOT_WEBHOOK_AUTH=replace-with-your-bearer-key
